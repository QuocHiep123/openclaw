# AI Research Lab Automation System
# Copy this file to .env and fill in your values

# --- LLM Provider (choose one or both) ---
OPENAI_API_KEY=your-openai-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_API_KEYS=key1,key2,key3

# --- Runtime mode ---
# bot | server | cli | daily | nlp_daily_report
APP_MODE=bot

# --- LLM Model Settings ---
LLM_PROVIDER=openai
# Options: openai, google
LLM_MODEL=gpt-4o-mini
# For google: gemini-1.5-flash

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=
# Comma-separated Telegram user IDs (leave empty to allow all)

# --- Chroma Vector DB ---
CHROMA_PERSIST_DIR=./data/chroma

# --- arXiv Settings ---
ARXIV_DEFAULT_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_MAX_PAPERS=20

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8100

# --- Logging ---
LOG_LEVEL=INFO

# --- NLP/LLM daily research report (PDF email) ---
RESEARCH_REPORT_ENABLED=true
RESEARCH_REPORT_HOUR=7
RESEARCH_REPORT_MINUTE=30
RESEARCH_REPORT_RECIPIENT=dangquochiep2908@gmail.com
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
